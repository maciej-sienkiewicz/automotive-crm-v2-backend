      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-metrics"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT snapshot_date::timestamptz AS time,\n       stickiness_permille / 10.0 AS \"Stickiness\"\nFROM metric_daily_platform_snapshots\nWHERE snapshot_date >= $__timeFrom()::date AND snapshot_date <= $__timeTo()::date\nORDER BY 1"
        }
      ],
      "fieldConfig": {
