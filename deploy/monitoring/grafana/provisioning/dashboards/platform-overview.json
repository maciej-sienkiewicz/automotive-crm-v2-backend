    {
      "id": 12,
      "type": "timeseries",
      "title": "Aktywne studia: DAU / WAU / MAU",
      "description": "Studio liczy się jako aktywne, gdy miało tego dnia choć jedną znaczącą sesję — czyli z realną interakcją, nie samą otwartą kartą.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-metrics"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT snapshot_date::timestamptz AS time,\n       dau_studios AS \"DAU (studia)\",\n       wau_studios AS \"WAU (studia)\",\n       mau_studios AS \"MAU (studia)\"\nFROM metric_daily_platform_snapshots\nWHERE snapshot_date >= $__timeFrom()::date AND snapshot_date <= $__timeTo()::date\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Stickiness (DAU/MAU)",
      "description": "Jaka część bazy, która pojawia się w miesiącu, pojawia się danego dnia. Dla CRM-a używanego operacyjnie zdrowy zakres to kilkadziesiąt procent; trwały spadek wyprzedza churn o tygodnie.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
