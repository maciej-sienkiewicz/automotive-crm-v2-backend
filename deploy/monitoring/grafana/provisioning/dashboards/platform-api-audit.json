      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-metrics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT dir.name                       AS \"Studio\",\n       COUNT(DISTINCT i.fingerprint)  AS \"Różne defekty\",\n       SUM(i.occurrences)             AS \"Wystąpienia\",\n       MAX(i.last_seen_at)            AS \"Ostatnio\"\nFROM metric_error_group_impacts i\nJOIN metric_error_groups g   ON g.fingerprint = i.fingerprint\nJOIN metric_studio_directory dir ON dir.id = i.studio_id\nWHERE g.status IN ('NEW', 'ACKNOWLEDGED')\nGROUP BY dir.name\nORDER BY 2 DESC, 3 DESC\nLIMIT 50"
        }
