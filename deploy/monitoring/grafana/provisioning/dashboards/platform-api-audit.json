          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT g.title                AS \"Defekt\",\n       g.origin               AS \"Źródło\",\n       g.severity             AS \"Waga\",\n       g.status               AS \"Status\",\n       g.affected_studios     AS \"Studia\",\n       g.occurrence_count     AS \"Wystąpienia\",\n       g.first_seen_at        AS \"Pierwszy raz\",\n       g.last_seen_at         AS \"Ostatnio\",\n       g.fingerprint          AS \"Fingerprint\"\nFROM metric_error_groups g\nWHERE g.status IN ('NEW', 'ACKNOWLEDGED')\nORDER BY g.affected_studios DESC, g.last_seen_at DESC\nLIMIT 100"
        }
      ],
