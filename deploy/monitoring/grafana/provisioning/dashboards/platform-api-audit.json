          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sad.module                          AS \"Moduł\",\n       SUM(sad.call_count)                 AS \"Wywołania\",\n       COUNT(DISTINCT sad.studio_id)       AS \"Studia\",\n       ROUND(SUM(sad.total_duration_ms)::numeric\n             / NULLIF(SUM(sad.call_count), 0), 1) AS \"Śr. czas (ms)\",\n       MAX(sad.max_duration_ms)            AS \"Maks. czas (ms)\"\nFROM metric_studio_api_daily sad\nWHERE sad.usage_date >= CURRENT_DATE - 30\nGROUP BY sad.module\nORDER BY 2 DESC"
        }
