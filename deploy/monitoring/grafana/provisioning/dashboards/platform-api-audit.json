    {
      "id": 8,
      "type": "table",
      "title": "Endpointy wg czasu ciszy",
      "description": "Nigdy nie wywołane na górze, potem najdłużej milczące. Kolumna „Studia 30d” oddziela skrypt integracyjny jednego studia od funkcji, na której opiera się cała baza klientów — w surowej liczbie wywołań wyglądają identycznie. Klasyfikacja DEAD / DORMANT wraz z zabezpieczeniem okna obserwacji jest w GET /api/internal/metrics/api-audit i to ona jest wiążąca; tu są same fakty, żeby ta reguła nie żyła w dwóch miejscach naraz.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-metrics"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-metrics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT e.http_method                                  AS \"Metoda\",\n       e.path_template                                AS \"Ścieżka\",\n       e.module                                       AS \"Moduł\",\n       e.controller                                   AS \"Kontroler\",\n       COALESCE(e.days_silent::text, 'nigdy')         AS \"Dni ciszy\",\n       e.calls_30d                                    AS \"Wywołania 30d\",\n       e.studios_30d                                  AS \"Studia 30d\",\n       e.total_calls                                  AS \"Wywołania łącznie\",\n       e.requires_auth                                AS \"Wymaga sesji\"\nFROM metric_endpoint_usage e\nWHERE e.is_retention_exempt = false\nORDER BY (e.last_called_at IS NOT NULL), e.days_silent DESC NULLS FIRST, e.calls_30d\nLIMIT 300"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
