          "editorMode": "code",
          "rawSql": "SELECT s.snapshot_date                     AS \"Dzień\",\n       s.sms_sent                          AS \"SMS\",\n       s.emails_sent                       AS \"E-maile\",\n       s.sms_credits_remaining             AS \"Pozostałe kredyty SMS\",\n       s.avg_latency_ms                    AS \"Śr. opóźnienie API (ms)\"\nFROM metric_daily_studio_snapshots s\nWHERE s.studio_id = '$studio'::uuid\n  AND s.snapshot_date >= $__timeFrom()::date AND s.snapshot_date <= $__timeTo()::date\nORDER BY 1 DESC\nLIMIT 60"
        }
