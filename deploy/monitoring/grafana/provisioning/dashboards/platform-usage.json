    {
      "id": 6,
      "type": "table",
      "title": "Studia wg czasu pracy",
      "description": "Konta aktywne vs ogółem to wykorzystanie stanowisk — płacenie za sześć kont przy dwóch używanych poprzedza downgrade i jest dobrym pretekstem do rozmowy.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-metrics"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-metrics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT dir.name                                              AS \"Studio\",\n       ROUND(SUM(s.active_minutes_total)    / 60.0, 1)       AS \"Godziny łącznie\",\n       ROUND(SUM(s.active_minutes_owner)    / 60.0, 1)       AS \"Właściciel\",\n       ROUND(SUM(s.active_minutes_employee) / 60.0, 1)       AS \"Pracownicy\",\n       SUM(s.sessions_count)                                 AS \"Sesje\",\n       MAX(s.users_active)                                   AS \"Aktywne konta\",\n       MAX(s.users_total)                                    AS \"Konta ogółem\",\n       SUM(s.reservations_created)                           AS \"Rezerwacje\"\nFROM metric_daily_studio_snapshots s\nJOIN metric_studio_directory dir ON dir.id = s.studio_id\nWHERE s.snapshot_date >= $__timeFrom()::date AND s.snapshot_date <= $__timeTo()::date\nGROUP BY dir.name\nHAVING SUM(s.active_minutes_total) > 0\nORDER BY 2 DESC\nLIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
    },
