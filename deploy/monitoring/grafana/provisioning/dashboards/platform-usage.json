    {
      "id": 5,
      "type": "stat",
      "title": "Mediana sesji (min)",
      "description": "Mediana, nie tylko średnia: długość sesji jest mocno skośna w prawo — garstka użytkowników pracujących cały dzień ciągnie średnią daleko powyżej tego, jak wygląda typowa sesja.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-metrics"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-metrics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY active_seconds))::numeric / 60.0, 1) AS \"Mediana\"\nFROM metric_user_sessions\nWHERE is_meaningful = true\n  AND session_date >= $__timeFrom()::date AND session_date <= $__timeTo()::date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
