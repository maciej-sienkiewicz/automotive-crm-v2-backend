    {
      "id": 12,
      "type": "table",
      "title": "Adopcja modułów — $studio",
      "description": "Wiersz wart reakcji to moduł z zerem wywołań, za który studio płaci. Lista modułów pochodzi z katalogu endpointów, nie z ruchu — moduł nieużywany MUSI się tu pojawić, a zapytanie oparte o ruch nie potrafiłoby go wyprodukować.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-metrics"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-metrics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT m.module                                     AS \"Moduł\",\n       COALESCE(SUM(sad.call_count), 0)             AS \"Wywołania\",\n       MAX(sad.usage_date)                          AS \"Ostatnio użyty\"\nFROM (SELECT DISTINCT module FROM metric_api_endpoints WHERE is_active_in_code = true) m\nLEFT JOIN metric_studio_api_daily sad\n       ON sad.module = m.module AND sad.studio_id = '$studio'::uuid\nGROUP BY m.module\nORDER BY 2 DESC, 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
