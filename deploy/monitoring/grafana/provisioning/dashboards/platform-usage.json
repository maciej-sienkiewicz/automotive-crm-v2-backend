    {
      "id": 8,
      "type": "table",
      "title": "Ryzyko odejścia (stan na ostatni policzony dzień)",
      "description": "Sortowane po ryzyku, a POTEM po zagrożonym przychodzie — ten board rozdziela czas opiekuna klienta, a konto próbne za 39 zł nad studiem za 400 zł w spadku odwraca ten priorytet. Powody niskiego wyniku w języku naturalnym zwraca GET /api/internal/metrics/health.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-metrics"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-metrics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT dir.name                                  AS \"Studio\",\n       s.plan_key                                AS \"Pakiet\",\n       s.subscription_status                     AS \"Status\",\n       s.churn_risk                              AS \"Ryzyko\",\n       s.health_score                            AS \"Health\",\n       ROUND(s.mrr_gross_cents / 100.0, 2)       AS \"MRR\",\n       EXTRACT(DAY FROM (now() - s.last_activity_at))::int AS \"Dni od aktywności\",\n       s.users_active                            AS \"Konta aktywne\",\n       s.users_total                             AS \"Konta ogółem\"\nFROM metric_daily_studio_snapshots s\nJOIN metric_studio_directory dir ON dir.id = s.studio_id\nWHERE s.snapshot_date = (SELECT MAX(snapshot_date) FROM metric_daily_studio_snapshots)\nORDER BY CASE s.churn_risk\n             WHEN 'CRITICAL' THEN 0 WHEN 'AT_RISK' THEN 1\n             WHEN 'WATCH'    THEN 2 ELSE 3 END,\n         s.mrr_gross_cents DESC\nLIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ryzyko"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "CRITICAL": {
                        "color": "red",
                        "index": 0,
                        "text": "Krytyczny"
                      },
                      "AT_RISK": {
                        "color": "orange",
                        "index": 1,
                        "text": "Zagrożony"
                      },
                      "WATCH": {
                        "color": "yellow",
                        "index": 2,
                        "text": "Do obserwacji"
                      },
                      "HEALTHY": {
                        "color": "green",
                        "index": 3,
                        "text": "Zdrowy"
                      },
                      "UNKNOWN": {
                        "color": "text",
                        "index": 4,
                        "text": "Nieprzeliczony"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
