    {
      "id": 2,
      "type": "timeseries",
      "title": "Godziny pracy: właściciele vs pracownicy",
      "description": "Czas ZAANGAŻOWANY, nie czas otwartej karty. Pojedynczy heartbeat może dopisać najwyżej 90 sekund, więc laptop zamknięty na noc dopisuje 90 s zamiast 16 godzin. Podział OWNER/EMPLOYEE jest zapisywany na sesji w chwili jej otwarcia, więc awans pracownika nie przepisuje historii wstecz.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-metrics"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT snapshot_date::timestamptz AS time,\n       ROUND(SUM(active_minutes_owner)    / 60.0, 1) AS \"Właściciele\",\n       ROUND(SUM(active_minutes_employee) / 60.0, 1) AS \"Pracownicy\"\nFROM metric_daily_studio_snapshots\nWHERE snapshot_date >= $__timeFrom()::date AND snapshot_date <= $__timeTo()::date\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Odsetek sesji odrzuconych",
      "description": "Sesje odfiltrowane jako puste (poniżej 30 s zaangażowania albo zero interakcji). To metryka jakości SAMEGO POMIARU: gwałtowna zmiana oznacza, że heartbeat po stronie frontu przestał działać — i widać to od razu, a nie miesiąc później, gdy ktoś zauważy, że użycie „urosło” o 40% bez nowych klientów.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-metrics"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE NOT is_meaningful)\n             / NULLIF(COUNT(*), 0), 1) AS \"Puste sesje\"\nFROM metric_user_sessions\nWHERE session_date >= $__timeFrom()::date AND session_date <= $__timeTo()::date"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Średnia sesja (min)",
      "description": "",
      "datasource": {
