{
  "uid": "crm-storage",
  "title": "Miejsce w S3",
  "description": "Ile miejsca w buckecie S3 zajmuje każde studio i cała platforma. Pomiar z pełnego listingu bucketu (bieżące wersje obiektów), odświeżany co godzinę. Nie obejmuje wersji niebieżących ani porzuconych multipart uploadów — te widać tylko w CloudWatch / na rachunku AWS.",
  "tags": [
    "crm",
    "live-metrics"
  ],
  "timezone": "Europe/Warsaw",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5m",
  "graphTooltip": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "label": "Studio",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(max by (tenant, tenant_id) (crm_storage_tenant_bytes))",
          "refId": "tenant_id"
        },
        "definition": "query_result(max by (tenant, tenant_id) (crm_storage_tenant_bytes))",
        "regex": "/tenant=\"(?<text>[^\"]*)\",\\s*tenant_id=\"(?<value>[^\"]*)\"/",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "tenant_name",
        "label": "Nazwa studia",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(crm_storage_tenant_bytes{tenant_id=\"$tenant_id\"}, tenant)",
          "refId": "tenant_name"
        },
        "definition": "label_values(crm_storage_tenant_bytes{tenant_id=\"$tenant_id\"}, tenant)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "hide": 2
      }
    ]
  },
